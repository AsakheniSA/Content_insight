# Copy to .env.local for `npm run dev`. Never commit .env.local.
# The same service-account key the pipeline uses, base64 on one line (raw JSON also works):
#   base64 -w0 service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
# Optional. Leave blank for open pages; set it to require a shared password.
VIEW_PASSWORD=
# Optional. Leave blank for an open /api/feed; set it (e.g. openssl rand -hex 32) to
# require Authorization: Bearer <token>.
FEED_API_TOKEN=
# The daily trigger (/api/cron/run-pipeline, scheduled in vercel.json). Both optional;
# without them the trigger is off and only GitHub's own schedule runs the pipeline.
#   CRON_SECRET: a long random string (openssl rand -hex 32). Vercel sends it automatically.
#   GITHUB_DISPATCH_TOKEN: a fine-grained GitHub token for this repository only, with
#   "Actions: Read and write" permission.
CRON_SECRET=
GITHUB_DISPATCH_TOKEN=
