# Tula Insights Layer — local environment.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Claude API -------------------------------------------------------------
# Also pays for the server-side web search tool. An organisation admin must
# enable web search in the Claude Console before the discovery stages work.
ANTHROPIC_API_KEY=

# --- Google Sheets ----------------------------------------------------------
# The whole service-account JSON key, BASE64-ENCODED to a single line.
# Encode it with:
#   macOS/Linux:  base64 -w0 service_account.json      (macOS: base64 -i service_account.json)
#   Windows PS:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service_account.json"))
# Raw (un-encoded) JSON is also accepted, but base64 is what the GitHub secret
# should hold: the private key contains newlines that raw .env files mangle.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The spreadsheet ID — the part of the sheet URL between /d/ and /edit.
SHEET_ID=

# --- YouTube (collector lands in stage 7; leave blank until then) ------------
YOUTUBE_API_KEY=

# --- Optional local overrides -----------------------------------------------
# Pin "today" for reproducible tests, e.g. 2026-11-25
# TULA_TODAY=
# Logging level: DEBUG, INFO, WARNING, ERROR
# TULA_LOG_LEVEL=INFO
